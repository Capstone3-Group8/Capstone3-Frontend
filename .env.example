# Copy this file to ".env" for local development:
#   cp .env.example .env
#
# Vite only exposes variables that start with VITE_, and it bakes them into the
# built JavaScript — so NEVER put secrets (passwords, API keys) here. They would
# ship to every visitor's browser.
#
# Vite reads .env once at startup. Change a value -> restart `npm run dev`.

# The backend API this frontend talks to.
# Local dev: your Express server. Production: your deployed backend URL.
VITE_API_URL=http://localhost:8080

# ---------- Auth0 ----------
# From your Auth0 dashboard. The app won't start without all three — it tells
# you which ones are missing instead of rendering a blank page.

# Your Auth0 tenant domain — no https:// (Applications > your app > Settings).
VITE_AUTH0_DOMAIN=dev-auth0domain-goes-here.us.auth0.com

# The Client ID of your Auth0 SPA application. Public by design: it identifies
# the app, it doesn't authorize anything. Safe to ship to the browser.
VITE_AUTH0_CLIENT_ID=your-client-id-goes-here

# The Identifier of the API you created in Auth0 (Applications > APIs).
# It's a name, not a URL you visit — Auth0 just uses URL-shaped names.
#
# This must be BYTE-FOR-BYTE identical to the backend's AUTH0_AUDIENCE. If they
# differ, login looks like it works and then every API call returns 401 — the
# most common way to get stuck.
VITE_AUTH0_AUDIENCE=https://capstone-api
